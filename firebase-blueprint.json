{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Edible oil and herbal oil products in Aiman Brand store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "subCategoryId": { "type": "string", "maxLength": 128 },
        "brandId": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 100 },
        "shortDesc": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "benefits": { "type": "string", "maxLength": 2000 },
        "usage": { "type": "string", "maxLength": 2000 },
        "badge": { "type": "string", "maxLength": 50 },
        "isFeatured": { "type": "boolean" },
        "showOnHome": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nameBn", "slug", "categoryId", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nameBn": { "type": "string", "maxLength": 150 },
        "nameEn": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "image": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "isFeaturedHome": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "nameBn", "slug", "isActive"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 20 },
        "alternativePhone": { "type": "string", "maxLength": 20 },
        "district": { "type": "string", "maxLength": 100 },
        "thana": { "type": "string", "maxLength": 100 },
        "fullAddress": { "type": "string", "maxLength": 500 },
        "orderNotes": { "type": "string", "maxLength": 500 },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "orderStatus": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "phone", "district", "thana", "fullAddress", "total", "orderStatus"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "userName", "rating", "comment"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon codes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "maxLength": 20 },
        "discountValue": { "type": "number" },
        "minOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "discountType", "discountValue", "isActive"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional banners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "link": { "type": "string", "maxLength": 300 },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "isActive"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and contact info",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 }
      },
      "required": ["siteName", "phone", "whatsappNumber"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalog for Aiman Brand"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories for organizing oil and natural products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product customer reviews"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupon codes"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Hero and promotional banners"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store-wide settings"
    }
  }
}
