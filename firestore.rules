rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Role check from users collection or custom claim
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'admin' || getUserData().role == 'super_admin' || getUserData().role == 'manager'))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: public can read active products, admin has full access
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Brands: public read, admin write
    match /brands/{brandId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Banners: public read active, admin write
    match /banners/{bannerId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Home Sections: public read, admin write
    match /homeSections/{sectionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: anyone can create an order with valid fields; owner or admin can read
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'customerName', 'phone', 'district', 'thana', 'fullAddress', 'total', 'orderStatus'])
                    && request.resource.data.total >= 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 11;
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Coupons: anyone can check active coupons; admin manages
    match /coupons/{couponId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Reviews: anyone can read approved reviews, signed-in users can create review
    match /reviews/{reviewId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if isSignedIn() && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Store Settings & Pages: public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection:
    // User can read their own document
    // User cannot change their own 'role' field (prevents self-escalation)
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) || request.resource.data.role == 'customer'
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Admins list: strictly admin
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Activity Logs: only admin
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
